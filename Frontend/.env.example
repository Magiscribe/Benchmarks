# This file contains environment variables for the client application.
# These values can be retrieved from the AWS Console after deploying the infrastructure.

# AWS Cognito User Pool ID - Required for authentication
# Find this in AWS Console > Cognito > User Pools > [Your User Pool] > General Settings
# Format: region_string-alphanumeric (e.g., us-east-1_abcd1234)
VITE_COGNITO_USER_POOL_ID=************

# AWS Cognito User Pool Client ID - Required for authentication
# Find this in AWS Console > Cognito > User Pools > [Your User Pool] > App integration > App clients and analytics
# Format: alphanumeric string (e.g., 1a2b3c4d5e6f7g8h9i0j)
VITE_COGNITO_USER_POOL_CLIENT_ID=************

# API Gateway URL - Required for making API calls
# Find this in AWS Console > API Gateway > [Your API] > Stages > [Stage name]
# Format: complete URL with https:// (e.g., https://abc123def.execute-api.us-east-1.amazonaws.com/prod)
VITE_API_URL=************

# Authentication Configuration
# Set to 'true' to enable regular username/password login
VITE_ENABLE_COGNITO_LOGIN=false

# Set to 'true' to enable custom provider (e.g., Google) login
VITE_ENABLE_CUSTOM_PROVIDER=false

# The name of the custom provider if enabled
VITE_CUSTOM_PROVIDER_NAME=Google

# OAuth Configuration (only needed if VITE_ENABLE_CUSTOM_PROVIDER is true)
# Cognito domain for hosted UI
VITE_COGNITO_DOMAIN=auth.example.com

# Redirect URLs (comma-separated if multiple)
VITE_OAUTH_REDIRECT_SIGN_IN=http://localhost:5173
VITE_OAUTH_REDIRECT_SIGN_OUT=http://localhost:5173

# OAuth scopes (comma-separated)
VITE_OAUTH_SCOPES=email,openid,profile,aws.cognito.signin.user.admin

# OAuth response type (code or token)
VITE_OAUTH_RESPONSE_TYPE=code
