# LLM Eye Test Configuration
# Copy this file to .env and fill in your values

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Dataset Configuration
IMAGES_PER_FONT=3
OUTPUT_DIR=test_images
DATASET_FILE=dataset.json

# Evaluation Settings
# Set one of these models as your default:
# Anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku, claude-3-5-sonnet, claude-3-5-haiku, claude-3-7-sonnet
# OpenAI: gpt-4-vision-preview, gpt-4o, gpt-4.1, o4-mini
# Google: gemini-2.5-pro, gemini-2.5-flash
# Groq: llama-4-maverick, llama-4-scout
DEFAULT_MODEL=claude-3-7-sonnet
RESPONSES_DIR=data/responses
RESULTS_DIR=data/results